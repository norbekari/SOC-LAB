<group name="soclab,windows,authentication,">

  <!-- 100100 : 5 echecs de connexion sur le MEME COMPTE en 2 minutes -->
  <rule id="100100" level="10" frequency="5" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>SOC-Lab : serie d'echecs d'authentification sur le compte $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,soclab_bruteforce,</group>
  </rule>

  <!-- 100101 : connexion REUSSIE sur le meme compte, dans les 5 min apres la serie d'echecs -->
  <rule id="100101" level="12" timeframe="300">
    <if_sid>60106</if_sid>
    <if_matched_sid>100100</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>SOC-Lab : connexion reussie sur $(win.eventdata.targetUserName) apres une serie d'echecs (compromission possible)</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,soclab_bruteforce,</group>
  </rule>

</group>
